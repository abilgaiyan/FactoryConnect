<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>FactoryConnect.Dashboard</RootNamespace>
    <AssemblyName>FactoryConnect.Dashboard</AssemblyName>
    <DashboardClientDirectory>$(MSBuildProjectDirectory)/ClientApp</DashboardClientDirectory>
    <BuildDashboardClient Condition="'$(BuildDashboardClient)' == ''">true</BuildDashboardClient>
  </PropertyGroup>

  <Target Name="BuildDashboardClientAssets" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildDashboardClient)' == 'true'">
    <Exec WorkingDirectory="$(DashboardClientDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(DashboardClientDirectory)" Command="npm run build" />
  </Target>

  <Target Name="CopyDashboardClientToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <DashboardPublishedAsset Include="$(MSBuildProjectDirectory)/wwwroot/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(DashboardPublishedAsset)"
      DestinationFiles="@(DashboardPublishedAsset->'$(PublishDir)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
